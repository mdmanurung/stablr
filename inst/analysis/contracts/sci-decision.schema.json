{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stablr.example/schemas/sci-decision-v1.json",
  "title": "stablr SCI-04 independent decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "decision_type", "review_bundle_manifest_sha256", "decision", "reviewer_id", "reviewed_at", "target"],
  "properties": {
    "schema_version": {"const": "stablr.sci-decision/v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_type": {"const": "sci"},
    "review_bundle_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["accepted", "rejected"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"const": "SCI-04-independent-review-packet-v2"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
